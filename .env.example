# Set a unique password before the first database initialization.
PTAT_DEMO_PASSWORD=
# MySQL is the default database. Create the database/user first, or use docker compose up -d mysql.
PTAT_DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ptat
MYSQL_USER=ptat
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
PTAT_ADMIN_PASSWORD=
# Optional OpenAI-compatible model credential. Configure its variable name in Administration.
PTAT_AI_TOKEN=
# BSS credentials are server-only; configure variable references in Environments.
PTAT_PRODUCTION_BSS_TOKEN=
# Required only behind HTTPS ingress. Keep false for HTTP local development.
PTAT_SECURE_COOKIES=false
# Optional absolute path for local SQLite persistence.
# PTAT_DATA_DIR=/workspace/ptat-data
# Set the exact public origin behind HTTPS ingress for CSRF validation.
# PTAT_PUBLIC_ORIGIN=https://ptat.your-company.example
