# Set a unique password before the first database initialization.
PTAT_DEMO_PASSWORD=
# Required only behind HTTPS ingress. Keep false for HTTP local development.
PTAT_SECURE_COOKIES=false
# Optional absolute path for local SQLite persistence.
# PTAT_DATA_DIR=/workspace/ptat-data
# Set the exact public origin behind HTTPS ingress for CSRF validation.
# PTAT_PUBLIC_ORIGIN=https://ptat.your-company.example
