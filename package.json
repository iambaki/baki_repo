{
  "name": "ptat",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/portal.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/portal.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:http": "node tests/http-smoke.mjs",
    "test:e2e": "node tests/browser-smoke.mjs",
    "test:enterprise": "node tests/enterprise-http.mjs",
    "test:enterprise:e2e": "node tests/enterprise-browser.mjs",
    "test:proxy": "node tests/live-proxy.mjs",
    "format": "prettier --write app components lib tests docs scripts server README.md next.config.ts tsconfig.json package.json .github compose.yaml",
    "format:check": "prettier --check app components lib tests docs scripts server README.md next.config.ts tsconfig.json package.json .github compose.yaml"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "next": "^16.3.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^8.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
